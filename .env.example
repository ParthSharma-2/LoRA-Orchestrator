# Hugging Face Hub Token (Write permission for uploading models/adapters)
HF_TOKEN=hf_your_token_here

# Weights & Biases Telemetry
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=smollm2-qlora

# Optional Hugging Face Target Repo (e.g. username/smollm2-guanaco)
HF_REPO_ID=

# Optional: Default Modal GPU accelerator (A10G, T4, A100)
MODAL_GPU=A10G
